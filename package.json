{
  "name": "hrforte-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:no-turbopack": "next dev",
    "build": "next build",
    "build:no-lint": "DISABLE_ESLINT_PLUGIN=true next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prisma:generate": "prisma generate --schema=src/lib/prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema=src/lib/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/lib/prisma/schema.prisma",
    "db:migrate:up": "scripts/migrate.sh up",
    "db:migrate:down": "scripts/migrate.sh down -l",
    "db:migrate:down:all": "scripts/migrate.sh down -a",
    "db:migrate:status": "scripts/migrate.sh status",
    "db:migrate:new": "scripts/migrate.sh new"
  },
